# Notion
NOTION_TOKEN=secret_xxx
NOTION_REQUESTS_DB_ID=
NOTION_BUDGETS_DB_ID=
NOTION_RUNLOG_DB_ID=

# AI
ANTHROPIC_API_KEY=

# Durable state — Render free Postgres connection string.
# If unset, falls back to an in-memory store (dev/test only, NOT durable).
DATABASE_URL=

# Email (Resend HTTPS API — smtplib/SMTP ports are blocked on Render free tier)
RESEND_API_KEY=
FROM_EMAIL=sanction@example.edu
ACCOUNTS_EMAIL=accounts@example.edu

# Shared secret required in the X-Webhook-Secret header on /webhook/request
WEBHOOK_SECRET=

# Policy
AUTO_APPROVE_CAP_FRACTION=0.15   # a single request above 15% of remaining category budget is escalated
DUPLICATE_WINDOW_DAYS=7
MAX_AUTO_APPROVE_AMOUNT=50000    # hard sanity ceiling regardless of budget headroom
